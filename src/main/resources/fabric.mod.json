{
  "schemaVersion": 1,
  "id": "rosetta_library",
  "version": "${version}",
  "name": "Rosetta",
  "description": "Cross-version and cross-loader compatibility primitives for Minecraft mods.",
  "authors": ["Rasa Novum"],
  "contact": {
    "sources": "https://github.com/Rasa-Novum/Rosetta_Library"
  },
  "license": "MIT",
  "icon": "rosetta_library_icon.png",
  "environment": "*",
  "mixins": ["rosetta.mixins.json"],
  "entrypoints": {
    "main": ["net.rasanovum.rosetta.loaders.fabric.RosettaFabric"],
    "client": ["net.rasanovum.rosetta.loaders.fabric.RosettaFabricClient"]
  },
  "depends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": "${minecraft_version}"
  }
}
